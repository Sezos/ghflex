{
  "name": "ghflex",
  "version": "0.1.1",
  "description": "Your whole GitHub in one screenshot. Stats, stack, streak, and how much of it AI wrote.",
  "type": "module",
  "bin": {
    "ghflex": "dist/cli.js"
  },
  "files": [
    "dist",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "github",
    "cli",
    "stats",
    "terminal",
    "ai",
    "instagram"
  ],
  "homepage": "https://github.com/Sezos/ghflex#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sezos/ghflex.git"
  },
  "bugs": {
    "url": "https://github.com/Sezos/ghflex/issues"
  },
  "author": "Badral",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@types/node": "^22.20.5",
    "opentype.js": "^2.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2"
  }
}
